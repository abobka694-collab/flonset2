-- =======================================================
-- ТВОЙ СОБСТВЕННЫЙ MM2 ХАБ С GUI (БЕЗ DRM И КИКОВ)
-- =======================================================

-- Загружаем проверенную и безопасную UI-библиотеку Kavo
local KavoLib = loadstring(game:HttpGet("https://githubusercontent.com"))()

-- Создаем главное окно чита (Тема "Midnight" — темно-синяя)
local Window = KavoLib.CreateLib("FLONSET HUB (MM2)", "Midnight")

-- =======================================================
-- ВКЛАДКА 1: LOCAL PLAYER (Настройки персонажа)
-- =======================================================
local Tab1 = Window:NewTab("Player")
local Section1 = Tab1:NewSection("Movement")

-- Переменные для контроля функций
local speedEnabled = false
local speedValue = 32

-- Слайдер для выбора скорости бега
Section1:NewSlider("Speed Value", "Выбери скорость (Рекомендуется до 35)", 100, 16, function(s)
    speedValue = s
end)

-- Переключатель (Toggle) для активации скорости
Section1:NewToggle("Enable Speed Mod", "Включает безопасное ускорение", function(state)
    speedEnabled = state
end)

-- Постоянный цикл в фоне для поддержки выбранной скорости
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            if speedEnabled then
                local char = game.Players.LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.WalkSpeed ~= speedValue then
                    hum.WalkSpeed = speedValue
                end
            else
                -- Если выключено, возвращаем стандартную скорость Roblox
                local char = game.Players.LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.WalkSpeed > 16 then
                    hum.WalkSpeed = 16
                end
            end
        end)
    end
end)

-- =======================================================
-- ВКЛАДКА 2: VISUALS (Подсветка игроков и ролей)
-- =======================================================
local Tab2 = Window:NewTab("Visuals")
local Section2 = Tab2:NewSection("ESP Settings")

local espEnabled = false
local currentHighlights = {}

-- Функция создания подсветки для конкретного игрока
local function createESP(player)
    if player == game.Players.LocalPlayer then return end
    
    local function onCharAdded(char)
        task.wait(0.5)
        if not espEnabled then return end
        
        -- Если старый силуэт остался, удаляем его
        if currentHighlights[player] then
            pcall(function() currentHighlights[player]:Destroy() end)
        end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "Flonset_ESP"
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = char
        highlight.Parent = game:GetService("CoreGui") -- Прячем от античета в CoreGui
        
        currentHighlights[player] = highlight
        
        -- Динамическое обновление цвета роли в реальном времени
        task.spawn(function()
            while char and char.Parent and espEnabled do
                local hasKnife = char:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")
                local hasGun = char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun")
                
                if hasKnife then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Убийца
                    highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                elseif hasGun then
                    highlight.FillColor = Color3.fromRGB(0, 150, 255) -- Шериф
                    highlight.OutlineColor = Color3.fromRGB(0, 150, 255)
                else
                    highlight.FillColor = Color3.fromRGB(0, 255, 100) -- Невинный
                    highlight.OutlineColor = Color3.fromRGB(0, 255, 100)
                end
                task.wait(1)
            end
            if highlight then pcall(function() highlight:Destroy() end) end
            currentHighlights[player] = nil
        end)
    end
    
    if player.Character then task.spawn(onCharAdded, player.Character) end
    player.CharacterAdded:Connect(onCharAdded)
end

-- Переключатель для включения/выключения ESP
Section2:NewToggle("Player ESP (Roles)", "Подсвечивает роли игроков сквозь стены", function(state)
    espEnabled = state
    if state then
        -- Включаем для всех текущих игроков
        for _, player in ipairs(game.Players:GetPlayers()) do
            createESP(player)
        end
    else
        -- Очищаем память и удаляем все силуэты при выключении
        for player, hl in pairs(currentHighlights) do
            pcall(function() hl:Destroy() end)
        end
        table.clear(currentHighlights)
    end
end)

-- Автоматически вешаем обработчик на новых заходящих на сервер игроков
game.Players.PlayerAdded:Connect(function(player)
    if espEnabled then createESP(player) end
end)

print("[FLONSET-HUB] Инжект меню прошел успешно!")
